  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 53
  indentLevel: 0
  storyText: It's not like that, that's a little too cruel for me. I'm just wondering if you know anything as to why-
  description: 
  character: {fileID: 886748052}
  portrait: {fileID: -2536396195673936148, guid: eb7cf8d16d4ab88488e151eb41d01ba6, type: 3}
