  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 52
  indentLevel: 0
  storyText: W-whaat?! Don't tell me.. Getting blood comes with a price..!
  description: 
  character: {fileID: 587923503}
  portrait: {fileID: 7862619902346014006, guid: f3d50a3e39d3ed848bb929163f49a7a7, type: 3}
